<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>PresetCommunity</AssemblyName>
    <RootNamespace />
    <Version>1.0.1</Version>
    <OptionStrict>On</OptionStrict>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LakeUI" Version="5.110.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <Compile Remove="tests\**\*.vb" />
  </ItemGroup>
  <Target Name="StagePlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)PresetCommunity.3fui.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginInstallDir)\PresetCommunity.3fui.dll" Condition="'$(PluginInstallDir)' != ''" />
  </Target>
</Project>
